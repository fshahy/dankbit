<?xml version="1.0"?>

<odoo>
    <record id="dankbit_chat_log_view_list" model="ir.ui.view">
        <field name="name">dankbit.chat.log.view.list</field>
        <field name="model">dankbit.chat.log</field>
        <field name="arch" type="xml">
            <list string="Chat Log" decoration-danger="error" decoration-warning="unverified_numbers">
                <field name="create_date" string="Asked"/>
                <field name="user_id"/>
                <field name="asset"/>
                <field name="question"/>
                <field name="unverified_numbers"/>
                <field name="retried" optional="hide"/>
                <field name="elapsed_seconds"/>
                <field name="model" optional="hide"/>
                <field name="error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dankbit_chat_log_view_form" model="ir.ui.view">
        <field name="name">dankbit.chat.log.view.form</field>
        <field name="model">dankbit.chat.log</field>
        <field name="arch" type="xml">
            <form string="Chat Log">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Asked"/>
                            <field name="user_id"/>
                            <field name="asset"/>
                            <field name="instrument"/>
                            <field name="window_hours"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="elapsed_seconds"/>
                            <field name="retried"/>
                            <field name="unverified_numbers"/>
                        </group>
                    </group>
                    <group string="Question"><field name="question" nolabel="1" colspan="2"/></group>
                    <group string="Answer"><field name="answer" nolabel="1" colspan="2"/></group>
                    <group string="Tool Calls"><field name="tool_calls" nolabel="1" colspan="2"/></group>
                    <group string="Error" invisible="not error"><field name="error" nolabel="1" colspan="2"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dankbit_chat_log_view_search" model="ir.ui.view">
        <field name="name">dankbit.chat.log.view.search</field>
        <field name="model">dankbit.chat.log</field>
        <field name="arch" type="xml">
            <search string="Search Chat Log">
                <field name="question"/>
                <field name="user_id"/>
                <filter string="Only BTC" name="btc" domain="[('asset', '=', 'BTC')]"/>
                <filter string="Only ETH" name="eth" domain="[('asset', '=', 'ETH')]"/>
                <separator/>
                <filter string="Unverified Numbers" name="unverified" domain="[('unverified_numbers', '!=', False)]"/>
                <filter string="Errors" name="errors" domain="[('error', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dankbit_chat_log_action" model="ir.actions.act_window">
        <field name="name">Chat Log</field>
        <field name="res_model">dankbit.chat.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="dankbit_chat_log_menu" name="Chat Log"
        action="dankbit_chat_log_action"
        parent="dankbit_root_menu"
        sequence="55"/>
</odoo>
