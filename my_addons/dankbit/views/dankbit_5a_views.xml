<?xml version="1.0"?>

<odoo>
    <record id="dankbit_5a_view_form" model="ir.ui.view">
        <field name="name">dankbit_5a.view.form</field>
        <field name="model">dankbit.5a</field>
        <field name="arch" type="xml">
            <form string="5A Gamma Snapshot">
                <sheet>
                    <group>
                        <field name="computed_at" />
                        <field name="asset" />
                    </group>
                    <group string="Nearest">
                        <field name="nearest_instrument" />
                        <field name="nearest_avg_price" />
                        <field name="nearest_avg_value" />
                        <field name="nearest_trade_count" />
                    </group>
                    <group string="Weekly">
                        <field name="weekly_instrument" />
                        <field name="weekly_avg_price" />
                        <field name="weekly_avg_value" />
                        <field name="weekly_trade_count" />
                    </group>
                    <group string="Monthly">
                        <field name="monthly_instrument" />
                        <field name="monthly_avg_price" />
                        <field name="monthly_avg_value" />
                        <field name="monthly_trade_count" />
                    </group>
                    <group string="All">
                        <field name="all_avg_price" />
                        <field name="all_avg_value" />
                        <field name="all_trade_count" />
                    </group>
                    <group string="Last 24h">
                        <field name="day_avg_price" />
                        <field name="day_avg_value" />
                        <field name="day_trade_count" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dankbit_5a_view_list" model="ir.ui.view">
        <field name="name">dankbit_5a.view.list</field>
        <field name="model">dankbit.5a</field>
        <field name="arch" type="xml">
            <list string="5A Gamma Snapshot">
                <field name="computed_at" />
                <field name="asset" />
                <field name="nearest_instrument" />
                <field name="nearest_avg_price" />
                <field name="weekly_avg_price" />
                <field name="monthly_avg_price" />
                <field name="all_avg_price" />
                <field name="day_avg_price" />
                <field name="nearest_avg_value" optional="hide" />
                <field name="weekly_avg_value" optional="hide" />
                <field name="monthly_avg_value" optional="hide" />
                <field name="all_avg_value" optional="hide" />
                <field name="day_avg_value" optional="hide" />
                <field name="nearest_trade_count" optional="hide" />
                <field name="weekly_trade_count" optional="hide" />
                <field name="monthly_trade_count" optional="hide" />
                <field name="all_trade_count" optional="hide" />
                <field name="day_trade_count" optional="hide" />
            </list>
        </field>
    </record>

    <record id="dankbit_5a_view_search" model="ir.ui.view">
        <field name="name">dankbit_5a.view.search</field>
        <field name="model">dankbit.5a</field>
        <field name="arch" type="xml">
            <search string="Search 5A Gamma Snapshot">
                <field name="asset" string="Asset"/>

                <separator/>

                <filter name="only_btc" string="Only BTC" domain="[('asset', '=', 'BTC')]"/>
                <filter name="only_eth" string="Only ETH" domain="[('asset', '=', 'ETH')]"/>

                <group expand="0" string="Group By">
                    <filter string="Asset" name="asset" context="{'group_by':'asset'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dankbit_5a_action" model="ir.actions.act_window">
        <field name="name">5A Gamma</field>
        <field name="res_model">dankbit.5a</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="dankbit_5a_menu" name="5A Gamma"
        action="dankbit_5a_action"
        parent="dankbit_root_menu"
        sequence="46"/>
</odoo>
